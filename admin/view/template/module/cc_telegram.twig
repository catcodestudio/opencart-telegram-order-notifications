{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-cctg" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>

  <div class="container-fluid">
    <div id="alert-cctg"></div>
    <p class="text-muted">{{ text_lead }}</p>

    <ul class="nav nav-tabs mb-3" id="cctg-tabs">
      <li class="nav-item"><a href="#tab-settings" data-bs-toggle="tab" class="nav-link active">{{ text_settings_tab }}</a></li>
      <li class="nav-item"><a href="#tab-sms" data-bs-toggle="tab" class="nav-link">{{ text_sms_tab }} <span class="badge bg-primary">Pro</span></a></li>
      <li class="nav-item"><a href="#tab-log" data-bs-toggle="tab" class="nav-link" id="tab-log-link">{{ text_log_tab }}</a></li>
    </ul>

    <div class="tab-content">
      <div class="tab-pane active" id="tab-settings">
        <div class="card">
          <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
          <div class="card-body">
            <form id="form-cctg" action="{{ save }}" method="post">

              <fieldset>
                <legend>{{ text_connection }}</legend>

                <div class="row mb-3">
                  <label class="col-sm-3 col-form-label">{{ entry_status }}</label>
                  <div class="col-sm-9"><div class="form-check form-switch form-switch-lg">
                    <input type="hidden" name="module_cc_telegram_status" value="0"/>
                    <input type="checkbox" name="module_cc_telegram_status" value="1" class="form-check-input"{{ status == '1' ? ' checked' : '' }}/>
                  </div></div>
                </div>

                <div class="row mb-3">
                  <label class="col-sm-3 col-form-label" for="cctg-token">{{ entry_bot_token }}</label>
                  <div class="col-sm-9">
                    <input type="password" id="cctg-token" name="module_cc_telegram_bot_token" value="" class="form-control" autocomplete="new-password" placeholder="{{ bot_token_set ? text_secret_set : '123456789:AA...' }}"/>
                    <div class="form-text">{{ help_bot_token }}{% if bot_token_set %} <span class="text-success">{{ text_token_saved }}</span>{% endif %}</div>
                  </div>
                </div>

                <div class="row mb-3">
                  <label class="col-sm-3 col-form-label" for="cctg-chats">{{ entry_chat_ids }}</label>
                  <div class="col-sm-9">
                    <textarea id="cctg-chats" name="module_cc_telegram_chat_ids" rows="4" class="form-control" placeholder="123456789&#10;-1001234567890:42">{{ chat_ids }}</textarea>
                    <div class="form-text">{{ help_chat_ids }}</div>
                  </div>
                </div>

                <div class="row mb-3">
                  <label class="col-sm-3 col-form-label">{{ entry_silent }}</label>
                  <div class="col-sm-9"><div class="form-check form-switch form-switch-lg">
                    <input type="hidden" name="module_cc_telegram_silent" value="0"/>
                    <input type="checkbox" name="module_cc_telegram_silent" value="1" class="form-check-input"{{ silent == '1' ? ' checked' : '' }}/>
                  </div>
                  <div class="form-text">{{ help_silent }}</div></div>
                </div>

                <div class="row mb-3">
                  <div class="col-sm-9 offset-sm-3">
                    <button type="button" id="btn-test" class="btn btn-outline-primary"><i class="fa-solid fa-paper-plane"></i> {{ button_test }}</button>
                    <button type="button" id="btn-discover" class="btn btn-outline-secondary"><i class="fa-solid fa-magnifying-glass"></i> {{ button_discover }}</button>
                    <div id="cctg-result" class="mt-2"></div>
                  </div>
                </div>
              </fieldset>

              <fieldset>
                <legend>{{ text_events }}</legend>

                <div class="row mb-3">
                  <label class="col-sm-3 col-form-label">{{ entry_notify_new_order }}</label>
                  <div class="col-sm-9"><div class="form-check form-switch form-switch-lg">
                    <input type="hidden" name="module_cc_telegram_notify_new_order" value="0"/>
                    <input type="checkbox" name="module_cc_telegram_notify_new_order" value="1" class="form-check-input"{{ notify_new_order == '1' ? ' checked' : '' }}/>
                  </div>
                  <div class="form-text">{{ help_notify_new_order }}</div></div>
                </div>

                <div class="row mb-3">
                  <label class="col-sm-3 col-form-label">{{ entry_new_order_statuses }}</label>
                  <div class="col-sm-9">
                    <div class="border rounded p-2" style="max-height:220px;overflow:auto">
                      {% for s in order_statuses %}
                      <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="cctg-new-{{ s.order_status_id }}" name="module_cc_telegram_new_order_statuses[]" value="{{ s.order_status_id }}"{{ s.order_status_id in new_order_selected ? ' checked' : '' }}/>
                        <label class="form-check-label" for="cctg-new-{{ s.order_status_id }}">{{ s.name }}</label>
                      </div>
                      {% endfor %}
                    </div>
                  </div>
                </div>

                <div class="row mb-3">
                  <label class="col-sm-3 col-form-label">{{ entry_notify_status }}</label>
                  <div class="col-sm-9"><div class="form-check form-switch form-switch-lg">
                    <input type="hidden" name="module_cc_telegram_notify_status" value="0"/>
                    <input type="checkbox" name="module_cc_telegram_notify_status" value="1" class="form-check-input"{{ notify_status == '1' ? ' checked' : '' }}/>
                  </div>
                  <div class="form-text">{{ help_notify_status }}</div></div>
                </div>

                <div class="row mb-3">
                  <label class="col-sm-3 col-form-label">{{ entry_status_statuses }}</label>
                  <div class="col-sm-9">
                    <div class="border rounded p-2" style="max-height:220px;overflow:auto">
                      {% for s in order_statuses %}
                      <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="cctg-st-{{ s.order_status_id }}" name="module_cc_telegram_status_statuses[]" value="{{ s.order_status_id }}"{{ s.order_status_id in status_selected ? ' checked' : '' }}/>
                        <label class="form-check-label" for="cctg-st-{{ s.order_status_id }}">{{ s.name }}</label>
                      </div>
                      {% endfor %}
                    </div>
                  </div>
                </div>

                <div class="row mb-3">
                  <label class="col-sm-3 col-form-label">{{ entry_notify_low_stock }}</label>
                  <div class="col-sm-9"><div class="form-check form-switch form-switch-lg">
                    <input type="hidden" name="module_cc_telegram_notify_low_stock" value="0"/>
                    <input type="checkbox" name="module_cc_telegram_notify_low_stock" value="1" class="form-check-input"{{ notify_low_stock == '1' ? ' checked' : '' }}/>
                  </div>
                  <div class="form-text">{{ help_notify_low_stock }}</div></div>
                </div>

                <div class="row mb-3">
                  <label class="col-sm-3 col-form-label">{{ entry_low_stock_threshold }}</label>
                  <div class="col-sm-9">
                    <input type="number" min="0" max="10000" name="module_cc_telegram_low_stock_threshold" value="{{ low_stock_threshold }}" class="form-control" style="max-width:120px"/>
                    <div class="form-text">{{ help_low_stock_threshold }}</div>
                  </div>
                </div>

                <div class="row mb-3">
                  <label class="col-sm-3 col-form-label">{{ entry_retry }}</label>
                  <div class="col-sm-9"><div class="form-check form-switch form-switch-lg">
                    <input type="hidden" name="module_cc_telegram_retry_enabled" value="0"/>
                    <input type="checkbox" name="module_cc_telegram_retry_enabled" value="1" class="form-check-input"{{ retry_enabled == '1' ? ' checked' : '' }}/>
                  </div>
                  <div class="form-text">{{ help_retry }}</div></div>
                </div>

                <div class="row mb-3">
                  <label class="col-sm-3 col-form-label">{{ entry_max_attempts }}</label>
                  <div class="col-sm-9"><input type="number" min="1" max="20" name="module_cc_telegram_max_attempts" value="{{ max_attempts }}" class="form-control" style="max-width:120px"/></div>
                </div>
              </fieldset>

              <fieldset>
                <legend>{{ text_templates }}</legend>

                <div class="row mb-3">
                  <label class="col-sm-3 col-form-label">{{ entry_template_new_order }}</label>
                  <div class="col-sm-9"><textarea name="module_cc_telegram_template_new_order" rows="10" class="form-control font-monospace">{{ template_new_order }}</textarea></div>
                </div>
                <div class="row mb-3">
                  <label class="col-sm-3 col-form-label">{{ entry_template_status }}</label>
                  <div class="col-sm-9"><textarea name="module_cc_telegram_template_status" rows="5" class="form-control font-monospace">{{ template_status }}</textarea></div>
                </div>
                <div class="row mb-3">
                  <label class="col-sm-3 col-form-label">{{ entry_template_low_stock }}</label>
                  <div class="col-sm-9"><textarea name="module_cc_telegram_template_low_stock" rows="5" class="form-control font-monospace">{{ template_low_stock }}</textarea></div>
                </div>

                <div class="row">
                  <div class="col-sm-9 offset-sm-3">
                    <div class="form-text mb-2">{{ help_templates }}</div>
                    <div class="form-text">{{ text_placeholders }}</div>
                    <div>
                      {% for p in placeholders %}
                      <span class="badge bg-light text-dark border me-1 mb-1" title="{{ p.label }}"><code>{{ p.tag }}</code></span>
                      {% endfor %}
                    </div>
                  </div>
                </div>
              </fieldset>

            </form>
          </div>
        </div>
      </div>

      <div class="tab-pane" id="tab-sms">
        <div class="card mb-3">
          <div class="card-header"><i class="fa-solid fa-key"></i> {{ text_license }}</div>
          <div class="card-body">
            <p class="text-muted">{{ text_sms_lead }}</p>
            <div class="mb-3">
              {% if is_pro %}
              <span class="badge bg-success">{{ text_pro_active }}</span>
              {% if license_owned %} {{ text_license_owned }}{% elseif license_is_trial %} {{ text_trial_left|format(trial_days_left) }}{% endif %}
              {% else %}
              <span class="badge bg-secondary">{{ text_pro_inactive }}</span>
              {% if has_license %} <span class="text-danger">{{ text_license_invalid }}</span>{% endif %}
              {% endif %}
            </div>
            {% if has_license %}
            <div class="row mb-2">
              <label class="col-sm-3 col-form-label">{{ entry_license_key }}</label>
              <div class="col-sm-9"><code>{{ license_key_mask }}</code>
                <button type="button" class="btn btn-outline-danger btn-sm ms-2" id="btn-lic-deactivate">{{ button_license_deactivate }}</button>
                <div class="form-text">{{ help_license_deactivate }}</div>
              </div>
            </div>
            {% else %}
            <div class="row mb-3">
              <label class="col-sm-3 col-form-label" for="cctg-lic-key">{{ entry_license_key }}</label>
              <div class="col-sm-9">
                <div class="input-group" style="max-width:520px">
                  <input type="text" id="cctg-lic-key" class="form-control" placeholder="CC-XXXX-XXXX-XXXX" autocomplete="off"/>
                  <button type="button" class="btn btn-primary" id="btn-lic-activate">{{ button_license_activate }}</button>
                </div>
                <div class="form-text"><a href="{{ module_url }}" target="_blank" rel="noopener">{{ text_buy_license }}</a></div>
              </div>
            </div>
            {% if trial_available %}
            <div class="row mb-2">
              <label class="col-sm-3 col-form-label" for="cctg-trial-email">{{ entry_trial }}</label>
              <div class="col-sm-9">
                <div class="input-group" style="max-width:520px">
                  <input type="email" id="cctg-trial-email" class="form-control" value="{{ trial_email }}"/>
                  <button type="button" class="btn btn-outline-primary" id="btn-lic-trial">{{ button_trial }}</button>
                </div>
                <div class="form-text">{{ help_trial }}</div>
              </div>
            </div>
            {% endif %}
            {% endif %}
          </div>
        </div>

        <div class="card mb-3{{ is_pro ? '' : ' border-warning' }}">
          <div class="card-header"><i class="fa-solid fa-comment-sms"></i> {{ text_sms_gateway }} <span class="badge bg-primary">Pro</span></div>
          <div class="card-body">
            {% if not is_pro %}<div class="alert alert-warning">{{ text_sms_locked }}</div>{% endif %}
            <form id="form-cctg-sms" action="{{ sms_save }}" method="post">
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ entry_sms_enabled }}</label>
                <div class="col-sm-9"><div class="form-check form-switch form-switch-lg">
                  <input type="checkbox" name="sms_enabled" value="1" class="form-check-input"{{ sms_enabled == '1' ? ' checked' : '' }}/>
                </div></div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label" for="cctg-sms-gw">{{ entry_sms_gateway }}</label>
                <div class="col-sm-9">
                  <select id="cctg-sms-gw" name="sms_gateway" class="form-select" style="max-width:320px">
                    {% for id, label in sms_gateways %}<option value="{{ id }}"{{ id == sms_gateway ? ' selected' : '' }}>{{ label }}</option>{% endfor %}
                  </select>
                  <div class="form-text">{{ help_sms_gateway }}</div>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label" for="cctg-sms-key">{{ entry_sms_key }}</label>
                <div class="col-sm-9">
                  <input type="password" id="cctg-sms-key" name="sms_api_key" value="" class="form-control" style="max-width:520px" autocomplete="new-password" placeholder="{{ sms_key_set ? text_secret_set : '' }}"/>
                  <div class="form-text">{{ help_sms_key }}{% if sms_key_set %} <span class="text-success">{{ text_key_saved }}</span>{% endif %}</div>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label" for="cctg-sms-ch">{{ entry_sms_channel }}</label>
                <div class="col-sm-9">
                  <select id="cctg-sms-ch" name="sms_channel" class="form-select" style="max-width:320px">
                    <option value="viber_sms"{{ sms_channel == 'viber_sms' ? ' selected' : '' }}>{{ text_channel_hybrid }}</option>
                    <option value="viber"{{ sms_channel == 'viber' ? ' selected' : '' }}>{{ text_channel_viber }}</option>
                    <option value="sms"{{ sms_channel == 'sms' ? ' selected' : '' }}>{{ text_channel_sms }}</option>
                  </select>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label" for="cctg-sms-senders">{{ entry_sms_senders }}</label>
                <div class="col-sm-9">
                  <textarea id="cctg-sms-senders" name="sms_sms_senders" rows="3" class="form-control font-monospace" placeholder="UA=MyShop&#10;PL=MyShopPL&#10;*=MyShop">{{ sms_sms_senders }}</textarea>
                  <div class="form-text">{{ help_sms_senders }}</div>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label" for="cctg-viber-senders">{{ entry_viber_senders }}</label>
                <div class="col-sm-9"><textarea id="cctg-viber-senders" name="sms_viber_senders" rows="3" class="form-control font-monospace" placeholder="UA=MyShop&#10;*=MyShop">{{ sms_viber_senders }}</textarea></div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label" for="cctg-sms-country">{{ entry_sms_country }}</label>
                <div class="col-sm-9">
                  <select id="cctg-sms-country" name="sms_country" class="form-select" style="max-width:160px">
                    {% for iso in sms_countries %}<option value="{{ iso }}"{{ iso == sms_country ? ' selected' : '' }}>{{ iso }}</option>{% endfor %}
                  </select>
                  <div class="form-text">{{ help_sms_country }}</div>
                </div>
              </div>

              <legend class="mt-4">{{ text_sms_rules }}</legend>
              <div class="form-text mb-3">{{ help_sms_rules }}</div>
              {% for r in sms_rules %}
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ r.name }}</label>
                <div class="col-sm-9">
                  <div class="form-check form-switch">
                    <input type="checkbox" class="form-check-input" id="cctg-rule-{{ r.id }}" name="sms_rules[{{ r.id }}][on]" value="1"{{ r.on == '1' ? ' checked' : '' }}/>
                    <label class="form-check-label" for="cctg-rule-{{ r.id }}">{{ text_send }}</label>
                  </div>
                  <textarea name="sms_rules[{{ r.id }}][text]" rows="2" class="form-control font-monospace">{{ r.text }}</textarea>
                </div>
              </div>
              {% endfor %}
              <div class="row mb-3">
                <div class="col-sm-9 offset-sm-3">
                  <div class="form-text">{{ text_placeholders }}</div>
                  {% for tag in ['{site_name}', '{order_number}', '{order_total}', '{order_status}', '{order_status_old}', '{customer_first_name}', '{customer_name}', '{tracking_number}', '{comment}', '{shipping_method}', '{payment_method}', '{items}'] %}
                  <span class="badge bg-light text-dark border me-1 mb-1"><code>{{ tag }}</code></span>
                  {% endfor %}
                  <div class="form-text">{{ help_sms_tags }}</div>
                </div>
              </div>
              <div class="row mb-3">
                <div class="col-sm-9 offset-sm-3"><button type="submit" class="btn btn-primary"><i class="fa-solid fa-save"></i> {{ button_save }}</button></div>
              </div>
            </form>
          </div>
        </div>

        <div class="card mb-3">
          <div class="card-header"><i class="fa-solid fa-vial"></i> {{ text_sms_check }}</div>
          <div class="card-body">
            <div class="mb-3">
              <button type="button" id="btn-sms-balance" class="btn btn-outline-secondary">{{ button_sms_balance }}</button>
              <span class="form-text ms-2">{{ help_sms_balance }}</span>
            </div>
            <div class="input-group" style="max-width:520px">
              <input type="tel" id="cctg-sms-phone" class="form-control" placeholder="+380931234567"/>
              <button type="button" id="btn-sms-test" class="btn btn-outline-primary"{{ is_pro ? '' : ' disabled' }}>{{ button_sms_test }}</button>
            </div>
            <div class="form-text">{{ help_sms_test }}</div>
            <div id="cctg-sms-result" class="mt-2"></div>
          </div>
        </div>
      </div>

      <div class="tab-pane" id="tab-log"><div id="log-panel"></div></div>
    </div>
  </div>
</div>

<script type="text/javascript">
// Twig html-escapes controller URLs (& -> &amp;); harmless in an href but it
// breaks fetch() targets — the user_token is lost and OpenCart answers with the
// login page instead of JSON.
function ccTgUrl(s) { return s.replace(/&amp;/g, '&'); }

function ccTgAlert(html) {
  document.getElementById('alert-cctg').innerHTML = html;
  window.scrollTo(0, 0);
}

document.getElementById('form-cctg').addEventListener('submit', function (e) {
  e.preventDefault();
  fetch(ccTgUrl('{{ save }}'), { method: 'POST', body: new FormData(this) })
    .then(function (r) { return r.json(); })
    .then(function (json) {
      if (json.error) { ccTgAlert('<div class="alert alert-danger">' + json.error + '</div>'); }
      else if (json.success) { ccTgAlert('<div class="alert alert-success">' + json.success + '</div>'); }
    });
});

function ccTgCredentials() {
  const fd = new FormData();
  fd.append('module_cc_telegram_bot_token', document.getElementById('cctg-token').value);
  fd.append('module_cc_telegram_chat_ids', document.getElementById('cctg-chats').value);
  return fd;
}

function ccTgCall(url, btn) {
  const out = document.getElementById('cctg-result');
  out.innerHTML = '<span class="text-muted">…</span>';
  btn.disabled = true;
  fetch(ccTgUrl(url), { method: 'POST', body: ccTgCredentials() })
    .then(function (r) { return r.json(); })
    .then(function (json) {
      if (json.ok) { out.innerHTML = '<div class="alert alert-success mb-0">' + json.message + '</div>'; }
      else { out.innerHTML = '<div class="alert alert-danger mb-0">' + (json.error || 'Error') + '</div>'; }
    })
    .catch(function () { out.innerHTML = '<div class="alert alert-danger mb-0">Request failed</div>'; })
    .finally(function () { btn.disabled = false; });
}

document.getElementById('btn-test').addEventListener('click', function () { ccTgCall('{{ test }}', this); });
document.getElementById('btn-discover').addEventListener('click', function () { ccTgCall('{{ discover }}', this); });

// --- Pro: Viber / SMS ---------------------------------------------------------
function ccTgPost(url, fd) {
  return fetch(ccTgUrl(url), { method: 'POST', body: fd }).then(function (r) { return r.json(); });
}
function ccTgSmsOut(json) {
  const out = document.getElementById('cctg-sms-result');
  out.innerHTML = json.ok ? '<div class="alert alert-success mb-0">' + json.message + '</div>' : '<div class="alert alert-danger mb-0">' + (json.error || 'Error') + '</div>';
}
function ccTgLicense(url, fd) {
  ccTgPost(url, fd).then(function (json) {
    if (json.error) { ccTgAlert('<div class="alert alert-danger">' + json.error + '</div>'); return; }
    ccTgAlert('<div class="alert alert-success">' + json.success + '</div>');
    if (json.reload) { window.location.hash = 'tab-sms'; window.location.reload(); }
  });
}
document.getElementById('form-cctg-sms').addEventListener('submit', function (e) {
  e.preventDefault();
  ccTgPost('{{ sms_save }}', new FormData(this)).then(function (json) {
    ccTgAlert(json.error ? '<div class="alert alert-danger">' + json.error + '</div>' : '<div class="alert alert-success">' + json.success + '</div>');
  });
});
document.getElementById('btn-sms-balance').addEventListener('click', function () {
  ccTgPost('{{ sms_balance }}', new FormData()).then(ccTgSmsOut);
});
document.getElementById('btn-sms-test').addEventListener('click', function () {
  const fd = new FormData();
  fd.append('phone', document.getElementById('cctg-sms-phone').value);
  ccTgPost('{{ sms_test }}', fd).then(ccTgSmsOut);
});
[['btn-lic-activate', '{{ license_activate }}', 'license_key', 'cctg-lic-key'],
 ['btn-lic-trial', '{{ license_trial }}', 'trial_email', 'cctg-trial-email'],
 ['btn-lic-deactivate', '{{ license_deactivate }}', '', '']].forEach(function (b) {
  const btn = document.getElementById(b[0]);
  if (!btn) { return; }
  btn.addEventListener('click', function () {
    const fd = new FormData();
    if (b[2]) { fd.append(b[2], document.getElementById(b[3]).value); }
    ccTgLicense(b[1], fd);
  });
});
if (window.location.hash === '#tab-sms') {
  const link = document.querySelector('a[href="#tab-sms"]');
  if (link && window.bootstrap) { bootstrap.Tab.getOrCreateInstance(link).show(); }
}

document.getElementById('tab-log-link').addEventListener('click', function () {
  const panel = document.getElementById('log-panel');
  panel.innerHTML = '<div class="text-muted p-3">…</div>';
