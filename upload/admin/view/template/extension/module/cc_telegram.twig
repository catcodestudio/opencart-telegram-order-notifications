{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-cc-telegram" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>{% endif %}
    <div id="cctg-alert"></div>

    <ul class="nav nav-tabs">
      <li class="active"><a href="#tab-settings" data-toggle="tab">{{ tab_settings }}</a></li>
      <li><a href="#tab-sms" data-toggle="tab">{{ text_sms_tab }} <span class="label label-primary">Pro</span></a></li>
      <li><a href="#tab-log" data-toggle="tab">{{ tab_log }}</a></li>
    </ul>

    <div class="tab-content">

      <div class="tab-pane active" id="tab-settings">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-cc-telegram" class="form-horizontal">

          <div class="panel panel-default">
            <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-plug"></i> {{ text_connection }}</h3></div>
            <div class="panel-body">

              <div class="form-group">
                <label class="col-sm-3 control-label">{{ entry_status }}</label>
                <div class="col-sm-9">
                  <select name="module_cc_telegram_status" class="form-control">
                    <option value="1"{% if module_cc_telegram_status %} selected{% endif %}>{{ text_enabled }}</option>
                    <option value="0"{% if not module_cc_telegram_status %} selected{% endif %}>{{ text_disabled }}</option>
                  </select>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-3 control-label" for="cctg-token">{{ entry_token }}</label>
                <div class="col-sm-9">
                  <input type="password" name="module_cc_telegram_bot_token" value="" id="cctg-token" autocomplete="new-password" placeholder="{% if has_token %}{{ text_token_saved }}{% else %}123456789:AA...{% endif %}" class="form-control"/>
                  <div class="text-muted">{{ help_token }}{% if has_token %} <span class="text-success">{{ text_token_stored }}</span>{% endif %}</div>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-3 control-label" for="cctg-chats">{{ entry_chats }}</label>
                <div class="col-sm-9">
                  <textarea name="module_cc_telegram_chat_ids" rows="4" id="cctg-chats" placeholder="123456789&#10;-1001234567890:42" class="form-control">{{ module_cc_telegram_chat_ids }}</textarea>
                  <div class="text-muted">{{ help_chats }}</div>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-3 control-label">{{ entry_admin_url }}</label>
                <div class="col-sm-9">
                  <input type="text" name="module_cc_telegram_admin_url" value="{{ module_cc_telegram_admin_url }}" class="form-control"/>
                  <div class="text-muted">{{ help_admin_url }}</div>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-3 control-label">{{ entry_silent }}</label>
                <div class="col-sm-9">
                  <select name="module_cc_telegram_silent" class="form-control">
                    <option value="0"{% if not module_cc_telegram_silent %} selected{% endif %}>{{ text_disabled }}</option>
                    <option value="1"{% if module_cc_telegram_silent %} selected{% endif %}>{{ text_enabled }}</option>
                  </select>
                  <div class="text-muted">{{ help_silent }}</div>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-3 control-label">&nbsp;</label>
                <div class="col-sm-9">
                  <button type="button" id="cctg-test" class="btn btn-success"><i class="fa fa-paper-plane"></i> {{ button_test }}</button>
                  <button type="button" id="cctg-find" class="btn btn-default"><i class="fa fa-search"></i> {{ button_find }}</button>
                  <div class="text-muted" style="margin-top:6px">{{ help_tools }}</div>
                </div>
              </div>

            </div>
          </div>

          <div class="panel panel-default">
            <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-bell"></i> {{ text_events }}</h3></div>
            <div class="panel-body">

              <div class="form-group">
                <label class="col-sm-3 control-label">{{ entry_notify_new_order }}</label>
                <div class="col-sm-9">
                  <select name="module_cc_telegram_notify_new_order" class="form-control">
                    <option value="1"{% if module_cc_telegram_notify_new_order %} selected{% endif %}>{{ text_enabled }}</option>
                    <option value="0"{% if not module_cc_telegram_notify_new_order %} selected{% endif %}>{{ text_disabled }}</option>
                  </select>
                  <div class="well well-sm" style="margin-top:8px;margin-bottom:4px">
                    {% for order_status in order_statuses %}
                      <label class="checkbox-inline">
                        <input type="checkbox" name="module_cc_telegram_new_order_statuses[]" value="{{ order_status.order_status_id }}"{% if order_status.order_status_id in new_order_statuses %} checked{% endif %}/> {{ order_status.name }}
                      </label>
                    {% endfor %}
                  </div>
                  <div class="text-muted">{{ help_new_order }}</div>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-3 control-label">{{ entry_notify_status }}</label>
                <div class="col-sm-9">
                  <select name="module_cc_telegram_notify_status" class="form-control">
                    <option value="1"{% if module_cc_telegram_notify_status %} selected{% endif %}>{{ text_enabled }}</option>
                    <option value="0"{% if not module_cc_telegram_notify_status %} selected{% endif %}>{{ text_disabled }}</option>
                  </select>
                  <div class="well well-sm" style="margin-top:8px;margin-bottom:4px">
                    {% for order_status in order_statuses %}
                      <label class="checkbox-inline">
                        <input type="checkbox" name="module_cc_telegram_status_statuses[]" value="{{ order_status.order_status_id }}"{% if order_status.order_status_id in status_statuses %} checked{% endif %}/> {{ order_status.name }}
                      </label>
                    {% endfor %}
                  </div>
                  <div class="text-muted">{{ help_status }}</div>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-3 control-label">{{ entry_notify_low_stock }}</label>
                <div class="col-sm-9">
                  <select name="module_cc_telegram_notify_low_stock" class="form-control">
                    <option value="1"{% if module_cc_telegram_notify_low_stock %} selected{% endif %}>{{ text_enabled }}</option>
                    <option value="0"{% if not module_cc_telegram_notify_low_stock %} selected{% endif %}>{{ text_disabled }}</option>
                  </select>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-3 control-label">{{ entry_low_stock_qty }}</label>
                <div class="col-sm-9">
                  <input type="number" min="0" name="module_cc_telegram_low_stock_qty" value="{{ module_cc_telegram_low_stock_qty }}" class="form-control"/>
                  <div class="text-muted">{{ help_low_stock_qty }}</div>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-3 control-label">{{ entry_retry }}</label>
                <div class="col-sm-9">
                  <select name="module_cc_telegram_retry_enabled" class="form-control">
                    <option value="1"{% if module_cc_telegram_retry_enabled %} selected{% endif %}>{{ text_enabled }}</option>
                    <option value="0"{% if not module_cc_telegram_retry_enabled %} selected{% endif %}>{{ text_disabled }}</option>
                  </select>
                  <div class="text-muted">{{ help_retry }}</div>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-3 control-label">{{ entry_max_attempts }}</label>
                <div class="col-sm-9">
                  <input type="number" min="1" max="10" name="module_cc_telegram_max_attempts" value="{{ module_cc_telegram_max_attempts }}" class="form-control"/>
                  <div class="text-muted">{{ help_max_attempts }}</div>
                  <div class="text-muted" style="margin-top:6px">{{ help_cron }} <code>{{ cron_url }}</code></div>
                </div>
              </div>

            </div>
          </div>

          <div class="panel panel-default">
            <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-file-text-o"></i> {{ text_templates }}</h3></div>
            <div class="panel-body">

              <div class="form-group">
                <label class="col-sm-3 control-label">{{ entry_template_new_order }}</label>
                <div class="col-sm-9"><textarea name="module_cc_telegram_template_new_order" rows="10" class="form-control">{{ module_cc_telegram_template_new_order }}</textarea></div>
              </div>

              <div class="form-group">
                <label class="col-sm-3 control-label">{{ entry_template_status }}</label>
                <div class="col-sm-9"><textarea name="module_cc_telegram_template_status" rows="6" class="form-control">{{ module_cc_telegram_template_status }}</textarea></div>
              </div>

              <div class="form-group">
                <label class="col-sm-3 control-label">{{ entry_template_low_stock }}</label>
                <div class="col-sm-9"><textarea name="module_cc_telegram_template_low_stock" rows="6" class="form-control">{{ module_cc_telegram_template_low_stock }}</textarea></div>
              </div>

              <div class="form-group">
                <label class="col-sm-3 control-label">{{ text_tags }}</label>
                <div class="col-sm-9">
                  <p>{% for p in placeholders %}<code title="{{ p.text }}" style="margin-right:4px;cursor:help">&#123;{{ p.tag }}&#125;</code>{% endfor %}</p>
                  <div class="text-muted">{{ help_tags }}</div>
                </div>
              </div>

            </div>
          </div>

        </form>
      </div>

      <div class="tab-pane" id="tab-sms">
        <div class="panel panel-default">
          <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-key"></i> {{ text_license }}</h3></div>
          <div class="panel-body form-horizontal">
            <p class="text-muted">{{ text_sms_lead }}</p>
            <p>
              {% if is_pro %}<span class="label label-success">{{ text_pro_active }}</span>
                {% if license_owned %} {{ text_license_owned }}{% elseif license_is_trial %} {{ text_trial_left|format(trial_days_left) }}{% endif %}
              {% else %}<span class="label label-default">{{ text_pro_inactive }}</span>
                {% if has_license %} <span class="text-danger">{{ text_license_invalid }}</span>{% endif %}
              {% endif %}
            </p>
            {% if has_license %}
            <div class="form-group">
              <label class="col-sm-3 control-label">{{ entry_license_key }}</label>
              <div class="col-sm-9"><code>{{ license_key_mask }}</code>
                <button type="button" class="btn btn-danger btn-xs" id="cctg-lic-deactivate">{{ button_license_deactivate }}</button>
                <div class="text-muted">{{ help_license_deactivate }}</div>
              </div>
            </div>
            {% else %}
            <div class="form-group">
              <label class="col-sm-3 control-label" for="cctg-lic-key">{{ entry_license_key }}</label>
              <div class="col-sm-9">
                <div class="input-group" style="max-width:520px">
                  <input type="text" id="cctg-lic-key" class="form-control" placeholder="CC-XXXX-XXXX-XXXX" autocomplete="off"/>
                  <span class="input-group-btn"><button type="button" class="btn btn-primary" id="cctg-lic-activate">{{ button_license_activate }}</button></span>
                </div>
                <div class="text-muted"><a href="{{ module_url }}" target="_blank" rel="noopener">{{ text_buy_license }}</a></div>
              </div>
            </div>
            {% if trial_available %}
            <div class="form-group">
              <label class="col-sm-3 control-label" for="cctg-trial-email">{{ entry_trial }}</label>
              <div class="col-sm-9">
                <div class="input-group" style="max-width:520px">
                  <input type="email" id="cctg-trial-email" class="form-control" value="{{ trial_email }}"/>
                  <span class="input-group-btn"><button type="button" class="btn btn-default" id="cctg-lic-trial">{{ button_trial }}</button></span>
                </div>
                <div class="text-muted">{{ help_trial }}</div>
              </div>
            </div>
            {% endif %}
            {% endif %}
          </div>
        </div>

        <form id="form-cctg-sms" class="form-horizontal">
        <div class="panel panel-default">
          <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-commenting"></i> {{ text_sms_gateway }} <span class="label label-primary">Pro</span></h3></div>
          <div class="panel-body">
            {% if not is_pro %}<div class="alert alert-warning">{{ text_sms_locked }}</div>{% endif %}
            <div class="form-group">
              <label class="col-sm-3 control-label">{{ entry_sms_enabled }}</label>
              <div class="col-sm-9"><div class="checkbox"><label><input type="checkbox" name="sms_enabled" value="1"{% if sms_enabled == '1' %} checked{% endif %}/> {{ text_send }}</label></div></div>
            </div>
            <div class="form-group">
              <label class="col-sm-3 control-label" for="cctg-sms-gw">{{ entry_sms_gateway }}</label>
              <div class="col-sm-9">
                <select id="cctg-sms-gw" name="sms_gateway" class="form-control" style="max-width:320px">
                  {% for id, label in sms_gateways %}<option value="{{ id }}"{% if id == sms_gateway %} selected{% endif %}>{{ label }}</option>{% endfor %}
                </select>
                <div class="text-muted">{{ help_sms_gateway }}</div>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-3 control-label" for="cctg-sms-key">{{ entry_sms_key }}</label>
              <div class="col-sm-9">
                <input type="password" id="cctg-sms-key" name="sms_api_key" value="" class="form-control" style="max-width:520px" autocomplete="new-password" placeholder="{% if sms_key_set %}{{ text_secret_set }}{% endif %}"/>
                <div class="text-muted">{{ help_sms_key }}{% if sms_key_set %} <span class="text-success">{{ text_key_saved }}</span>{% endif %}</div>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-3 control-label" for="cctg-sms-ch">{{ entry_sms_channel }}</label>
              <div class="col-sm-9">
                <select id="cctg-sms-ch" name="sms_channel" class="form-control" style="max-width:320px">
                  <option value="viber_sms"{% if sms_channel == 'viber_sms' %} selected{% endif %}>{{ text_channel_hybrid }}</option>
                  <option value="viber"{% if sms_channel == 'viber' %} selected{% endif %}>{{ text_channel_viber }}</option>
                  <option value="sms"{% if sms_channel == 'sms' %} selected{% endif %}>{{ text_channel_sms }}</option>
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-3 control-label" for="cctg-sms-senders">{{ entry_sms_senders }}</label>
              <div class="col-sm-9">
                <textarea id="cctg-sms-senders" name="sms_sms_senders" rows="3" class="form-control" placeholder="UA=MyShop&#10;PL=MyShopPL&#10;*=MyShop">{{ sms_sms_senders }}</textarea>
                <div class="text-muted">{{ help_sms_senders }}</div>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-3 control-label" for="cctg-viber-senders">{{ entry_viber_senders }}</label>
              <div class="col-sm-9"><textarea id="cctg-viber-senders" name="sms_viber_senders" rows="3" class="form-control" placeholder="UA=MyShop&#10;*=MyShop">{{ sms_viber_senders }}</textarea></div>
            </div>
            <div class="form-group">
              <label class="col-sm-3 control-label" for="cctg-sms-country">{{ entry_sms_country }}</label>
              <div class="col-sm-9">
                <select id="cctg-sms-country" name="sms_country" class="form-control" style="max-width:160px">
                  {% for iso in sms_countries %}<option value="{{ iso }}"{% if iso == sms_country %} selected{% endif %}>{{ iso }}</option>{% endfor %}
                </select>
                <div class="text-muted">{{ help_sms_country }}</div>
              </div>
            </div>
          </div>
        </div>

        <div class="panel panel-default">
          <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-list"></i> {{ text_sms_rules }}</h3></div>
          <div class="panel-body">
            <p class="text-muted">{{ help_sms_rules }}</p>
            {% for r in sms_rules %}
            <div class="form-group">
              <label class="col-sm-3 control-label">{{ r.name }}</label>
              <div class="col-sm-9">
                <div class="checkbox"><label><input type="checkbox" name="sms_rules[{{ r.id }}][on]" value="1"{% if r.on == '1' %} checked{% endif %}/> {{ text_send }}</label></div>
                <textarea name="sms_rules[{{ r.id }}][text]" rows="2" class="form-control">{{ r.text }}</textarea>
              </div>
            </div>
            {% endfor %}
            <div class="form-group">
              <div class="col-sm-9 col-sm-offset-3">
                <div class="text-muted">{{ text_placeholders }}
                  {% for tag in ['{site_name}', '{order_number}', '{order_total}', '{order_status}', '{order_status_old}', '{customer_first_name}', '{customer_name}', '{tracking_number}', '{comment}', '{shipping_method}', '{payment_method}', '{items}'] %}<code>{{ tag }}</code> {% endfor %}
                </div>
                <div class="text-muted">{{ help_sms_tags }}</div>
                <p style="margin-top:12px"><button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> {{ button_save }}</button></p>
              </div>
            </div>
          </div>
        </div>
        </form>

        <div class="panel panel-default">
          <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-flask"></i> {{ text_sms_check }}</h3></div>
          <div class="panel-body">
            <p><button type="button" id="cctg-sms-balance" class="btn btn-default">{{ button_sms_balance }}</button> <span class="text-muted">{{ help_sms_balance }}</span></p>
            <div class="input-group" style="max-width:520px">
              <input type="tel" id="cctg-sms-phone" class="form-control" placeholder="+380XXXXXXXXX"/>
              <span class="input-group-btn"><button type="button" id="cctg-sms-test" class="btn btn-default"{% if not is_pro %} disabled{% endif %}>{{ button_sms_test }}</button></span>
            </div>
            <div class="text-muted">{{ help_sms_test }}</div>
          </div>
        </div>
      </div>

      <div class="tab-pane" id="tab-log">
        <div class="panel panel-default">
          <div class="panel-heading">
            <div class="pull-right"><a href="{{ clear_url }}" class="btn btn-danger btn-xs"><i class="fa fa-trash-o"></i> {{ button_clear_log }}</a></div>
            <h3 class="panel-title"><i class="fa fa-list"></i> {{ text_log }}</h3>
          </div>
          <div class="panel-body">
            <div class="table-responsive">
              <table class="table table-bordered table-hover">
                <thead>
                  <tr>
                    <td>{{ column_date }}</td>
                    <td>{{ column_order }}</td>
                    <td>{{ column_event }}</td>
                    <td>{{ column_chat }}</td>
                    <td>HTTP</td>
                    <td>{{ column_result }}</td>
                    <td>{{ column_attempts }}</td>
                    <td>{{ column_message }}</td>
                  </tr>
                </thead>
                <tbody>
                  {% if not logs %}<tr><td colspan="8" class="text-center">{{ text_no_results }}</td></tr>{% endif %}
                  {% for l in logs %}
                    <tr>
                      <td>{{ l.date_added }}</td>
                      <td>{% if l.order_id %}<a href="{{ l.href }}">#{{ l.order_id }}</a>{% else %}&mdash;{% endif %}</td>
                      <td>{{ l.event }}</td>
                      <td><code>{{ l.chat_id }}</code></td>
                      <td>{{ l.http }}</td>
                      <td>{% if l.success %}<span class="text-success"><b>OK</b></span>{% else %}<span class="text-danger"><b>{{ text_error }}</b></span>{% endif %}</td>
                      <td>{{ l.attempts }}</td>
                      <td><small>{{ l.message }}</small></td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
<script type="text/javascript">
// |raw — Twig would escape "&" in the URL to "&amp;", which breaks the query string.
var cctgTestUrl = '{{ test_url|raw }}';
var cctgFindUrl = '{{ find_url|raw }}';

function cctgAlert(json) {
  var box = $('#cctg-alert');
  box.empty();
  if (json.error) { box.prepend('<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> ' + json.error + '</div>'); }
  if (json.success) { box.prepend('<div class="alert alert-success"><i class="fa fa-check-circle"></i> ' + json.success + '</div>'); }
}

function cctgPost(url, button) {
  var original = button.html();
  button.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i>');
  $.ajax({
    url: url,
    type: 'post',
    dataType: 'json',
    data: {
      bot_token: $('#cctg-token').val(),
      chat_ids: $('#cctg-chats').val()
    },
    success: function (json) { cctgAlert(json); },
    error: function (xhr) { cctgAlert({ error: xhr.status + ' ' + xhr.statusText }); },
    complete: function () { button.prop('disabled', false).html(original); }
  });
}

$('#cctg-test').on('click', function () { cctgPost(cctgTestUrl, $(this)); });
$('#cctg-find').on('click', function () { cctgPost(cctgFindUrl, $(this)); });

// --- Pro: Viber / SMS ---------------------------------------------------------
function cctgSms(url, data, button) {
  var original = button ? button.html() : '';
  if (button) { button.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i>'); }
  $.ajax({
    url: url, type: 'post', dataType: 'json', data: data,
    success: function (json) {
      cctgAlert(json);
      $('html, body').animate({ scrollTop: 0 }, 200);
      if (json.reload) { window.location.hash = 'tab-sms'; window.location.reload(); }
    },
    error: function (xhr) { cctgAlert({ error: xhr.status + ' ' + xhr.statusText }); },
    complete: function () { if (button) { button.prop('disabled', false).html(original); } }
  });
}
$('#form-cctg-sms').on('submit', function (e) {
  e.preventDefault();
  cctgSms('{{ sms_save|raw }}', $(this).serialize(), $(this).find('button[type=submit]'));
});
$('#cctg-sms-balance').on('click', function () { cctgSms('{{ sms_balance|raw }}', {}, $(this)); });
$('#cctg-sms-test').on('click', function () { cctgSms('{{ sms_test|raw }}', { phone: $('#cctg-sms-phone').val() }, $(this)); });
$('#cctg-lic-activate').on('click', function () { cctgSms('{{ license_activate|raw }}', { license_key: $('#cctg-lic-key').val() }, $(this)); });
$('#cctg-lic-trial').on('click', function () { cctgSms('{{ license_trial|raw }}', { trial_email: $('#cctg-trial-email').val() }, $(this)); });
$('#cctg-lic-deactivate').on('click', function () { cctgSms('{{ license_deactivate|raw }}', {}, $(this)); });
